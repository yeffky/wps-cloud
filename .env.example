# Required: a long random token used by the client for authenticated API requests.
WPS_CLOUD_TOKEN=replace-with-a-long-random-secret

# Required: independent key used to sign short-lived upload/download tickets.
WPS_CLOUD_SIGNING_KEY=replace-with-another-long-random-secret

# Storage directory for document versions and metadata.
WPS_CLOUD_DATA_DIR=./data

# Bind locally by default. Put a TLS reverse proxy in front before exposing remotely.
WPS_CLOUD_HOST=127.0.0.1
WPS_CLOUD_PORT=8787

# Maximum accepted upload size in bytes (200 MiB by default).
WPS_CLOUD_MAX_UPLOAD_BYTES=209715200
